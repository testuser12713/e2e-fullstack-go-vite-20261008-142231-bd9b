{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "go",
      "kind": "server",
      "build": [
        [
          "go",
          "build",
          "-o",
          "./build/bookshelf",
          "./..."
        ]
      ],
      "test": [
        [
          "go",
          "test",
          "./..."
        ]
      ],
      "start": [
        "go",
        "run",
        "."
      ],
      "port": 8080,
      "port_env": "PORT",
      "health": {
        "path": "/api/health",
        "expect_status": [
          200
        ]
      },
      "env": {
        "PORT": {
          "dev": "8080"
        },
        "BOOKS_FILE": {
          "dev": "data/books.json"
        }
      }
    },
    {
      "name": "web",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [
        [
          "npm",
          "ci"
        ]
      ],
      "build": [
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "start": [
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "${PORT}",
        "--host"
      ],
      "port": 5173,
      "health": {
        "path": "/",
        "expect_status": [
          200
        ]
      },
      "env": {
        "VITE_API_BASE_URL": {
          "dev": "http://localhost:8080"
        }
      }
    }
  ]
}
